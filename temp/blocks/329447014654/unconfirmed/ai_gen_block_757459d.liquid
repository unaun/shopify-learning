{% doc %}
  @prompt
    a centred row with 2 columns, columns are horizontally oriented for large screen and vertically for small screens, the max gap between blocks inside is 40px and each of blocks contain the category image card
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ai-category-row-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
    align-items: stretch;
  }

  .ai-category-row-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-category-row-{{ ai_gen_id }}__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #f2f2f2;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-category-row-{{ ai_gen_id }}__image-wrap img,
  .ai-category-row-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-row-{{ ai_gen_id }}__empty-state {
    position: absolute;
    inset: auto 12px 12px;
    padding: 8px 10px;
    color: #333333;
    background: rgba(255, 255, 255, 0.94);
    border-radius: 4px;
    font-size: 13px;
    text-align: center;
  }

  .ai-category-row-{{ ai_gen_id }}__title {
    margin: 12px 0 0;
    color: inherit;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.25;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-row-{{ ai_gen_id }}__card[href]:hover .ai-category-row-{{ ai_gen_id }}__image-wrap img {
    transform: scale(1.03);
  }

  .ai-category-row-{{ ai_gen_id }}__image-wrap img {
    transition: transform 0.25s ease;
  }

  .ai-category-row-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-category-row-{{ ai_gen_id }}__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-category-row-{{ ai_gen_id }}__image-wrap img {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-category-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-row-{{ ai_gen_id }}__grid">
    {% for i in (1..2) %}
      {% liquid
        assign image_key = 'category_' | append: i | append: '_image'
        assign title_key = 'category_' | append: i | append: '_title'
        assign link_key = 'category_' | append: i | append: '_link'
        assign category_image = block.settings[image_key]
        assign category_title = block.settings[title_key]
        assign category_link = block.settings[link_key]
      %}
      {% if category_link != blank %}
        <a class="ai-category-row-{{ ai_gen_id }}__card" href="{{ category_link }}">
      {% else %}
        <div class="ai-category-row-{{ ai_gen_id }}__card">
      {% endif %}
          <div class="ai-category-row-{{ ai_gen_id }}__image-wrap">
            {% if category_image %}
              <img
                src="{{ category_image | image_url: width: 1200 }}"
                alt="{{ category_image.alt | default: category_title | escape }}"
                loading="lazy"
                width="{{ category_image.width }}"
                height="{{ category_image.height }}"
              >
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
              <span class="ai-category-row-{{ ai_gen_id }}__empty-state">Add a category image</span>
            {% endif %}
          </div>
          {% if category_title != blank %}
            <h3 class="ai-category-row-{{ ai_gen_id }}__title">{{ category_title | escape }}</h3>
          {% endif %}
      {% if category_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Category image row",
  "settings": [
    { "type": "header", "content": "Category cards" },
    { "type": "image_picker", "id": "category_1_image", "label": "First image" },
    { "type": "text", "id": "category_1_title", "label": "First title", "default": "Shop category one" },
    { "type": "url", "id": "category_1_link", "label": "First link" },
    { "type": "image_picker", "id": "category_2_image", "label": "Second image" },
    { "type": "text", "id": "category_2_title", "label": "Second title", "default": "Shop category two" },
    { "type": "url", "id": "category_2_link", "label": "Second link" },
    { "type": "header", "content": "Layout and style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 14, "max": 32, "step": 2, "unit": "px", "default": 20 },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "text_color", "label": "Title color", "default": "#333333" }
  ],
  "presets": [
    { "name": "Category image row" }
  ],
  "tag": null,
  "class": "category-image-row"
}
{% endschema %}