{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    text-align: {{ block.settings.alignment }};
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-glowing-heading-{{ ai_gen_id }}__text {
    display: inline-block;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.15;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-shadow: 0 0 6px {{ block.settings.glow_color }}, 0 0 18px {{ block.settings.glow_color }};
    animation: ai-glowing-heading-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glowing-heading-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 4px {{ block.settings.glow_color }}, 0 0 10px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 8px {{ block.settings.glow_color }}, 0 0 24px {{ block.settings.glow_color }}, 0 0 38px {{ block.settings.glow_color }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glowing-heading-{{ ai_gen_id }}__text {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glowing-heading-{{ ai_gen_id }}__text {
      animation: none;
    }
  }
{% endstyle %}

<div class="ai-glowing-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-glowing-heading-{{ ai_gen_id }}__text">{{ block.settings.heading | escape }}</h2>
  {% endif %}
</div>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Light up your storefront"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "work_sans_n4"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Size",
      "min": 18,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile size",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Glow style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow",
      "default": "#6D5DFB"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#17152B"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Pulse speed",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}