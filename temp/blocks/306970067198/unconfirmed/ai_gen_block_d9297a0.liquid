{% doc %}
  @prompt
    category image as bg image, name as title and description
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-card-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.card_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.fallback_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-category-card-{{ ai_gen_id }}__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-card-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 | times: 0.55 }}) 0%, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%);
  }

  .ai-category-card-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.fallback_color }};
  }

  .ai-category-card-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  .ai-category-card-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: {{ block.settings.card_height }}px;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-category-card-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.15;
  }

  .ai-category-card-{{ ai_gen_id }}__description {
    max-width: 60ch;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-category-card-{{ ai_gen_id }} {
      width: 100%;
      min-height: {{ block.settings.mobile_card_height }}px;
    }

    .ai-category-card-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_card_height }}px;
      padding: {{ block.settings.mobile_content_padding }}px;
    }
  }
{% endstyle %}

<div class="ai-category-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.category != blank and block.settings.category.image != blank %}
    <img
      class="ai-category-card-{{ ai_gen_id }}__background"
      src="{{ block.settings.category.image | image_url: width: 1800 }}"
      alt="{{ block.settings.category.image.alt | default: block.settings.category.title | escape }}"
      loading="lazy"
      width="{{ block.settings.category.image.width }}"
      height="{{ block.settings.category.image.height }}"
    >
  {% else %}
    <div class="ai-category-card-{{ ai_gen_id }}__placeholder">
      {{ 'collection-apparel-1' | placeholder_svg_tag }}
    </div>
  {% endif %}

  <div class="ai-category-card-{{ ai_gen_id }}__overlay"></div>

  <div class="ai-category-card-{{ ai_gen_id }}__content">
    {% if block.settings.category != blank %}
      <h2 class="ai-category-card-{{ ai_gen_id }}__title">{{ block.settings.category.title | escape }}</h2>
      {% if block.settings.category.description != blank %}
        <div class="ai-category-card-{{ ai_gen_id }}__description">
          {{ block.settings.category.description | strip_html | escape | truncate: 240 }}
        </div>
      {% endif %}
    {% else %}
      <h2 class="ai-category-card-{{ ai_gen_id }}__title">Choose a category</h2>
      <p class="ai-category-card-{{ ai_gen_id }}__description">Select a collection in the block settings to show its image, name, and description.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Category image card",
  "settings": [
    {
      "type": "collection",
      "id": "category",
      "label": "Category"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "mobile_card_height",
      "label": "Mobile height",
      "min": 180,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content spacing",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_content_padding",
      "label": "Mobile spacing",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback background",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Category image card"
    }
  ],
  "tag": null,
  "class": "category-image-card-block"
}
{% endschema %}