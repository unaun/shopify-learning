<div class="custom-section-wrapper" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="custom-container">
    
    {%- if section.settings.main_heading != blank -%}
      <div class="custom-section-header align-{{ section.settings.heading_alignment }}">
        <h2>{{ section.settings.main_heading | escape }}</h2>
      </div>
    {%- endif -%}


    <div class="custom-blocks-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text_block' -%}
            <div class="custom-block-item align-{{ block.settings.text_alignment }}" {{ block.shopify_attributes }}>
              
   
              {%- if block.settings.block_title != blank -%}
                <h3>{{ block.settings.block_title | escape }}</h3>
              {%- endif -%}
              
              {%- if block.settings.block_text != blank -%}
                <div class="custom-block-text">
                  {{ block.settings.block_text }}
                </div>
              {%- endif -%}
              
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</div>


<style>
  .custom-section-wrapper {
    width: 100%;
    box-sizing: border-box;
  }
  .custom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .custom-section-header {
    margin-bottom: 40px;
  }
  .custom-section-header h2 {
    font-size: 2rem;
    margin: 0;
  }
  .custom-blocks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .custom-block-item h3 {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 15px;
  }
  .custom-block-text {
    font-size: 1rem;
    line-height: 1.6;
  }

  .align-left { text-align: left; }
  .align-center { text-align: center; }
  .align-right { text-align: right; }

  @media screen and (min-width: 750px) {
    .custom-blocks-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .custom-section-header h2 {
      font-size: 2.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Section header",
      "default": "Section header"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Section header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section's paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom paddings",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text block",
      "settings": [
        {
          "type": "text",
          "id": "block_title",
          "label": "Block title",
          "default": "Block title"
        },
        {
          "type": "richtext",
          "id": "block_text",
          "label": "Block text",
          "default": "<p>Add any text here</p>"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header and 3 text blocks",
      "blocks": [
        { "type": "text_block" },
        { "type": "text_block" },
        { "type": "text_block" }
      ]
    }
  ]
}
{% endschema %}
