{% doc %}
  @prompt
    Collection sale section withajustable from section properties number of blocks aligned horizontally, each of this block contain one of selected subcollections represented by collection image,  collection name, Editable text "Price from {%lowerest price for items from this collection%}" and all the block is a link to collection page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-sale-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-sale__list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-collection-sale__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.card_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    overflow: hidden;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .ai-collection-sale__card-{{ ai_gen_id }}:hover {
    opacity: 0.82;
  }

  .ai-collection-sale__card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-collection-sale__image-wrap-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  .ai-collection-sale__image-{{ ai_gen_id }},
  .ai-collection-sale__image-wrap-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-sale__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-sale__title-{{ ai_gen_id }} {
    margin: 0 0 6px;
    color: inherit;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.25;
  }

  .ai-collection-sale__price-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.price_size }}px;
    line-height: 1.4;
  }

  .ai-collection-sale__empty-{{ ai_gen_id }} {
    padding: 24px;
    background: #f4f4f4;
    color: #333333;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-sale__list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
    }

    .ai-collection-sale__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.75 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-sale-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collections != blank %}
    <div class="ai-collection-sale__list-{{ ai_gen_id }}">
      {% for collection in block.settings.collections %}
        {% assign sorted_products = collection.products | sort: 'price' %}
        {% assign lowest_product = sorted_products | first %}
        {% assign collection_image = collection.image | default: collection.products.first.featured_image %}
        <a class="ai-collection-sale__card-{{ ai_gen_id }}" href="{{ collection.url }}" aria-label="{{ collection.title | escape }} — {{ block.settings.price_prefix | escape }} {% if lowest_product %}{{ lowest_product.price | money }}{% endif %}">
          <div class="ai-collection-sale__image-wrap-{{ ai_gen_id }}">
            {% if collection_image %}
              <img
                class="ai-collection-sale__image-{{ ai_gen_id }}"
                src="{{ collection_image | image_url: width: 900 }}"
                alt="{{ collection_image.alt | default: collection.title | escape }}"
                width="{{ collection_image.width }}"
                height="{{ collection_image.height }}"
                loading="lazy"
              >
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-collection-sale__content-{{ ai_gen_id }}">
            <h3 class="ai-collection-sale__title-{{ ai_gen_id }}">{{ collection.title | escape }}</h3>
            <p class="ai-collection-sale__price-{{ ai_gen_id }}">
              {{ block.settings.price_prefix | escape }}
              {% if lowest_product %}
                {{ lowest_product.price | money }}
              {% else %}
                {{ block.settings.no_products_text | escape }}
              {% endif %}
            </p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-collection-sale__empty-{{ ai_gen_id }}">
      {{ 'collection-apparel-1' | placeholder_svg_tag }}
      <p>Choose collections to display collection cards.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection sale cards",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price text",
      "default": "Price from"
    },
    {
      "type": "text",
      "id": "no_products_text",
      "label": "Empty price text",
      "default": "See collection"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Collection name size",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 12,
      "max": 22,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Text padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection sale cards"
    }
  ],
  "tag": null,
  "class": "collection-sale-cards"
}
{% endschema %}