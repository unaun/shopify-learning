{% doc %}
  @prompt
    section with editable header, ajustable from section properties number of blocks aligned horizontally, each of this block contain selected product, represented by product image,  product title, Editable text "Price from {%lowerest price for this product%}" and all the block is a link to collection page
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #333333;
  }

  .ai-product-collection__inner-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
  }

  .ai-product-collection__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    font-family: sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: #333333;
  }

  .ai-product-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-product-collection__card-{{ ai_gen_id }} {
    display: flex;
    min-width: 0;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-product-collection__card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .ai-product-collection__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f4f4f4;
  }

  .ai-product-collection__placeholder-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    aspect-ratio: 1 / 1;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #f4f4f4;
  }

  .ai-product-collection__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    color: #767676;
  }

  .ai-product-collection__empty-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 8px;
    right: 8px;
    color: #333333;
    font-size: 13px;
    text-align: center;
  }

  .ai-product-collection__details-{{ ai_gen_id }} {
    padding: 12px 0;
  }

  .ai-product-collection__title-{{ ai_gen_id }} {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
  }

  .ai-product-collection__price-{{ ai_gen_id }} {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }

  .ai-product-collection__card-{{ ai_gen_id }}:hover .ai-product-collection__title-{{ ai_gen_id }} {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.gap | times: 0.75 }}px;
    }

    .ai-product-collection__heading-{{ ai_gen_id }} {
      margin-bottom: 18px;
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-collection__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-product-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ai-product-collection__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}
        {% if product != blank %}
          {% assign card_collection = product.collections.first %}
          {% if card_collection != blank %}
            {% assign card_url = card_collection.url %}
          {% else %}
            {% assign card_url = routes.all_products_collection_url %}
          {% endif %}
          <a class="ai-product-collection__card-{{ ai_gen_id }}" href="{{ card_url }}" aria-label="{{ product.title | escape }} — {{ card_collection.title | default: 'View collection' | escape }}">
            {% if product.featured_image %}
              <img
                class="ai-product-collection__image-{{ ai_gen_id }}"
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {% else %}
              <div class="ai-product-collection__placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
                <span class="ai-product-collection__empty-{{ ai_gen_id }}">Add a product image</span>
              </div>
            {% endif %}
            <div class="ai-product-collection__details-{{ ai_gen_id }}">
              <h3 class="ai-product-collection__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
              <p class="ai-product-collection__price-{{ ai_gen_id }}">{{ block.settings.price_prefix | escape }} {{ product.price_min | money }}</p>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product collection row",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Products in a row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between products",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price text",
      "default": "Price from"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    },
    {
      "type": "product",
      "id": "product_7",
      "label": "Product 7"
    },
    {
      "type": "product",
      "id": "product_8",
      "label": "Product 8"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Product collection row"
    }
  ],
  "tag": null,
  "class": "product-collection-row"
}
{% endschema %}