      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Collection name size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price text size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Collection sale row"
    }
  ],
  "tag": null,
  "class": "collection-sale-row"
}
{% endschema %}