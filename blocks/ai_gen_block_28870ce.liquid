{% doc %}
  @prompt
    Collection sale section with max 4 blocks aligned horizontally, each of this block contain one of selected subcollections represented by collection image,  collection name, Editable text "Price from {%lowerest price for items from this collection%}" and all the block is a link to collection page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-sale-{{ ai_gen_id }} {
    margin:40px var(--page-margin);
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
  }

  .ai-collection-sale__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-collection-sale__card-{{ ai_gen_id }} {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.corner_radius }}px;
    transition: box-shadow 180ms ease;
  }

  .ai-collection-sale__card-{{ ai_gen_id }}:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-collection-sale__card-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-collection-sale__media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f3f3f3;
  }

  .ai-collection-sale__media-{{ ai_gen_id }} img,
  .ai-collection-sale__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-sale__body-{{ ai_gen_id }} {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-collection-sale__title-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .ai-collection-sale__price-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-size: {{ block.settings.price_size }}px;
    line-height: 1.45;
  }

  .ai-collection-sale__empty-{{ ai_gen_id }} {
    display: flex;
    min-height: 180px;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: #444444;
    background: #f3f3f3;
    text-align: center;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-sale__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 420px) {
    .ai-collection-sale__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-collection-sale-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-sale__grid-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign price_label_key = 'price_label_' | append: i
        assign selected_collection = block.settings[collection_key]
        assign price_label = block.settings[price_label_key]
      %}
      {% if selected_collection != blank %}
        {% assign lowest_product = selected_collection.products | sort: 'price' | first %}
        <a class="ai-collection-sale__card-{{ ai_gen_id }}" href="{{ selected_collection.url }}" aria-label="{{ selected_collection.title | escape }}">
          <div class="ai-collection-sale__media-{{ ai_gen_id }}">
            {% if selected_collection.featured_image %}
              <img
                src="{{ selected_collection.featured_image | image_url: width: 900 }}"
                alt="{{ selected_collection.featured_image.alt | default: selected_collection.title | escape }}"
                loading="lazy"
                width="{{ selected_collection.featured_image.width }}"
                height="{{ selected_collection.featured_image.height }}"
              >
            {% else %}
              <div class="ai-collection-sale__empty-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
                <span>Select a collection image in the collection settings.</span>
              </div>
            {% endif %}
          </div>
          <div class="ai-collection-sale__body-{{ ai_gen_id }}">
            <h3 class="ai-collection-sale__title-{{ ai_gen_id }}">{{ selected_collection.title | escape }}</h3>
            <p class="ai-collection-sale__price-{{ ai_gen_id }}">
              {{ price_label | escape }}
              {% if lowest_product %}{{ lowest_product.price | money }}{% else %}—{% endif %}
            </p>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Collection sale row",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "text",
      "id": "price_label_1",
      "label": "Price text 1",
      "default": "Price from"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "text",
      "id": "price_label_2",
      "label": "Price text 2",
      "default": "Price from"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "text",
      "id": "price_label_3",
      "label": "Price text 3",
      "default": "Price from"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "text",
      "id": "price_label_4",
      "label": "Price text 4",
      "default": "Price from"
    },
    {
      "type": "header",
      "content": "Layout and style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
