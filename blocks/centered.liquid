<div class="browser-centered-wrapper section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
  <div class="browser-centered-container">
    
    <!-- Системный контейнер Shopify для динамических вложенных блоков -->
    {% content_for 'blocks' %}

  </div>
</div>

{% style %}
  /* Базовые стили центрирования */
  .browser-centered-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .browser-centered-container {
    width: 100%;
    max-width: 1200px; /* Лимит ширины макета */
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Динамические отступы (с автоматическим уменьшением для мобильных) */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Centered Browser Layout",
  "tag": "section",
  "class": "section-centered-layout",
  "settings": [
    {
      "type": "header",
      "content": "Цвет фона"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Фон всей секции",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Вертикальные отступы"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Отступ сверху",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Отступ снизу",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Centered Browser Layout"
    }
  ]
}
{% endschema %}
